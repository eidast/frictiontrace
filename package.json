{
  "name": "frictiontrace",
  "version": "0.1.0",
  "description": "Digital experience monitoring focused on user friction in e-commerce",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "engine",
    "tests"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w engine",
    "test:integration": "npm run test:integration -w tests",
    "lint": "echo 'lint not yet configured'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "crux:dashboard": "npx tsx scripts/crux-dashboard.ts",
    "crux:dashboard:build": "npx tsx scripts/crux-dashboard.ts --build",
    "crux:sync": "set -a; . ./.env; set +a; npx tsx scripts/crux-sync.ts",
    "crux:group-report": "npx tsx scripts/crux-group-report.ts",
    "synthetic:run": "npx tsx scripts/synthetic-run.ts"
  },
  "license": "MIT",
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
