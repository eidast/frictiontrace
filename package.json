{
  "name": "frictiontrace",
  "version": "0.1.0",
  "description": "Digital experience monitoring focused on user friction in e-commerce",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "engine",
    "tests"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w engine",
    "test:integration": "npm run test:integration -w tests",
    "lint": "echo 'lint not yet configured'",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
